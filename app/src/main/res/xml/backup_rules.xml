<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-API-31 Auto Backup equivalent of data_extraction_rules.xml: nothing is uploaded.
     Diary and weight data are health data; the in-app backup is the only export path. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
