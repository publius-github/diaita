<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: the diary and weight history are health data, so nothing goes to cloud backup
     (the app promises no cloud). Direct device-to-device transfer stays on, as a convenience
     on top of the in-app backup/restore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
