<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: everything worth keeping is the Room database and DataStore settings.
     Nothing here is sensitive; GMS device-to-device transfer is a convenience on top of
     the in-app backup/restore, which remains the reliable path for sideload installs. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
